# Copy this file to .env and fill in real values. Never commit the real .env.

# Get this from your Neon project dashboard (Connection Details -> psycopg).
# Format: postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-example-12345.eu-central-1.aws.neon.tech/midman?sslmode=require

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Leave blank and the app works normally, just without AI fraud-risk scoring
# or AI request parsing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used to send status-change emails (receipts, approved/denied, completed).
# Leave blank during early dev - emails are skipped gracefully, logged to console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@midman.app
