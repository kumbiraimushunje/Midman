# Copy this file to .env and fill in real values. Never commit the real .env.

# Get this from your Neon project dashboard (Connection Details -> psycopg).
# Format: postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-example-12345.eu-central-1.aws.neon.tech/midman?sslmode=require

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# Leave blank and the app works normally, just without AI fraud-risk scoring
# or AI request parsing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used to send status-change emails (receipts, approved/denied, completed).
# Leave blank during early dev - emails are skipped gracefully, logged to console instead.
#
# Gmail (dev/testing): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=
# your Gmail address, SMTP_PASSWORD=a 16-character App Password (Google Account
# -> Security -> 2-Step Verification -> App passwords; requires 2-Step
# Verification to be enabled first), SMTP_FROM_EMAIL=the same Gmail address
# (Gmail rejects sends where From doesn't match the authenticated account).
# Fine for dev/testing; swap for SendGrid/Resend/SES before real volume -
# Gmail rate-limits and flags automated senders.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@midman.app

# Evidence file storage. Leave S3_BUCKET_NAME blank and uploads fall back to
# local disk (backend/uploads/) - fine for dev, but files won't survive a
# redeploy or work across multiple server instances. Use an IAM user scoped
# to only this bucket (s3:PutObject + s3:GetObject), not your root/admin keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Where the customer's browser lands after paying, on either gateway (a page
# in your deployed web app). Shared by both providers below.
PAYMENT_RETURN_URL=

# Zimbabwe-local payments (EcoCash/OneMoney/ZimSwitch/local bank cards) via
# Paynow (paynow.co.zw). Get your integration id/key from the Paynow merchant
# dashboard -> Integrations. Leave blank and the app works normally, just
# without the "Mobile money / local card" checkout option.
# PAYNOW_RESULT_URL is your backend's public /payments/paynow/webhook URL -
# Paynow calls this server-to-server, so it must be a real public HTTPS URL
# (won't work against localhost).
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=

# International card payments via Flutterwave. Get your secret key from the
# Flutterwave dashboard -> Settings -> API Keys (use a Test key while
# developing). FLUTTERWAVE_WEBHOOK_SECRET_HASH is a string YOU choose and set
# in the dashboard's Webhooks settings - Flutterwave echoes it back in every
# webhook call's verif-hash header so you can confirm the call really came
# from them. Leave both blank and the app works normally, just without the
# "International card" checkout option.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
